<?xml version="1.0" encoding="utf-8"?>
<!--
    Sessao de estudo (RF13, RF14, RF15).
    Uma questao por vez, com progresso n/total, alternativas selecionaveis,
    flag "acertei com duvida" e feedback apos confirmar.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Cerebro.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/title_study" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/session_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        app:trackCornerRadius="@dimen/spacing_xs" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="3 de 65" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/question_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                tools:text="Qual servico da AWS oferece armazenamento de objetos?" />

            <!-- Alternativas: populadas em runtime, no maximo cinco -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:nestedScrollingEnabled="false" />

            <!-- Feedback: so aparece depois de confirmar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feedback_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/feedback_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="Correto" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/feedback_correct_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/feedback_explanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Acoes fixas no rodape: alvo de toque sempre alcancavel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkbox_flagged"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/study_flag" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/spacing_s"
            android:enabled="false"
            android:text="@string/study_confirm" />
    </LinearLayout>
</LinearLayout>
