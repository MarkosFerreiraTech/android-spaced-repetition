<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Checkstyle do Cerebro.
    Foco em legibilidade e em evitar os code smells que o Sonar penaliza
    (metodos longos, muitos parametros, complexidade, nomes ruins).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter"/>
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <module name="OuterTypeFilename"/>
        <module name="OneTopLevelClass"/>

        <!-- Nomes -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ConstantName"/>
        <module name="PackageName"/>

        <!-- Boas praticas -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="IllegalThrows"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- Complexidade: alinhada ao limite do gate (RNF18) -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>
        <module name="NPathComplexity">
            <property name="max" value="256"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="6"/>
        </module>
        <module name="BooleanExpressionComplexity">
            <property name="max" value="4"/>
        </module>

        <!-- Documentacao -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>

        <!-- Proibicoes de seguranca e estilo -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun, com.sun, android.util.Log, java.util.logging"/>
            <property name="regexp" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.out\.print"/>
            <property name="message" value="Nao use System.out em codigo de producao: use o logger estruturado."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="printStackTrace"/>
            <property name="message" value="Nao use printStackTrace: trate a excecao e registre sem dados sensiveis (RF26)."/>
        </module>
    </module>
</module>
